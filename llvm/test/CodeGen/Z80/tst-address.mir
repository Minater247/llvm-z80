# RUN: split-file %s %t
# RUN: llc -start-before=z80-regalloc -verify-machineinstrs %t/z180.mir -o - | FileCheck %s --check-prefixes=CHECK,Z180
# RUN: llc -start-before=z80-regalloc -verify-machineinstrs %t/ez80.mir -o - | FileCheck %s --check-prefixes=CHECK,EZ80

# TST memory operands require HL even when the pointer arrives in IX.
# CHECK-LABEL: test:
# Z180: push ix
# Z180: pop hl
# EZ80: lea hl, ix
# CHECK: tst a, (hl)
# CHECK-NEXT: ret

#--- z180.mir
--- |
  target triple = "z80"
  define void @test() "target-cpu"="z180" { ret void }
...
---
name: test
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ix, $a
    %0:h16 = COPY $ix
    TST8ap %0, implicit-def $f, implicit $a :: (load (s8))
    RET16 implicit-def $sps, implicit $sps, implicit $a, implicit $f
...
#--- ez80.mir
--- |
  target triple = "ez80"
  define void @test() { ret void }
...
---
name: test
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $uix, $a
    %0:h24 = COPY $uix
    TST8ap %0, implicit-def $f, implicit $a :: (load (s8))
    RET24 implicit-def $spl, implicit $spl, implicit $a, implicit $f
...
