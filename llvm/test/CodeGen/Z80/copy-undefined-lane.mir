# RUN: llc -run-pass=postrapseudos -verify-machineinstrs %s -o - | FileCheck %s
--- |
  target triple = "z80"
  define void @partial() { ret void }
  define void @defined() { ret void }
  define void @distant_partial_store() { ret void }
...
---
name: partial
tracksRegLiveness: true
# CHECK-LABEL: name: partial
# CHECK: $c = LD8gg $l
# CHECK-NEXT: $b = LD8gg undef $h, implicit-def $bc
# CHECK-NEXT: $b = LD8ri 0
body: |
  bb.0:
    liveins: $hl
    $l = LD8gp killed $hl
    $bc = COPY $hl
    $b = LD8ri 0
    RET16 implicit-def $sps, implicit $sps, implicit $bc
...
---
name: defined
tracksRegLiveness: true
# CHECK-LABEL: name: defined
# CHECK: $c = LD8gg $l
# CHECK-NEXT: $b = LD8gg $h, implicit-def $bc
body: |
  bb.0:
    liveins: $hl
    $l = LD8gp $hl
    $bc = COPY $hl
    RET16 implicit-def $sps, implicit $sps, implicit $bc
...
---
name: distant_partial_store
tracksRegLiveness: true
# A single defined byte makes a pair use legal. Expanding the store must keep
# its other byte undefined even when its last definition is over 32 steps away.
# CHECK-LABEL: name: distant_partial_store
# CHECK: LD8og $ix, 0, undef $c
# CHECK-NEXT: LD8og $ix, 1, $b
body: |
  bb.0:
    liveins: $ix
    $b = LD8ri 42
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    $a = LD8ri 1
    LD88or $ix, 0, $bc :: (store (s16))
    RET16 implicit-def $sps, implicit $sps
...
