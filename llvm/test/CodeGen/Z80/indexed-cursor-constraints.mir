# RUN: llc -run-pass=z80-machine-prera-opt -verify-machineinstrs %s -o - | FileCheck %s
# RUN: %python %S/Inputs/cursor-placement.py llc %s %t.dir indexed_branch
--- |
  target triple = "z80"
  define i8 @indexed_branch() { ret i8 0 }
  define i8 @indexed_arguments() { ret i8 0 }
...
---
name: indexed_branch
tracksRegLiveness: true
selected: true
registers:
  - { id: 0, class: i16 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $de, $a
    %0:i16 = COPY $de
    OR8aa implicit-def $f, implicit $a
    JQCC %bb.2, 0, implicit $f
    JQ %bb.1
  bb.1:
    $a = LD8ap %0
    %0 = INC16r %0
    ADD8ap %0, implicit-def $a, implicit-def $f, implicit $a
    %0 = INC16r %0
    ADD8ap %0, implicit-def $a, implicit-def $f, implicit $a
    %0 = INC16r %0
    ADD8ap %0, implicit-def $a, implicit-def $f, implicit $a
    RET16 implicit-def $sps, implicit $sps, implicit $a
  bb.2:
    $a = LD8go %0, 2
    RET16 implicit-def $sps, implicit $sps, implicit $a
...
# CHECK-LABEL: name: indexed_branch
# CHECK: %0:a16 = COPY $de
# CHECK: %[[INDEX:[0-9]+]]:i16 = COPY %0
# CHECK-NEXT: $a = LD8go %[[INDEX]], 2
---
name: indexed_arguments
tracksRegLiveness: true
selected: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $de, $a
    %0:i16 = COPY $de
    OR8aa implicit-def $f, implicit $a
    JQCC %bb.2, 0, implicit $f
    JQ %bb.1
  bb.1:
    $a = LD8ap %0
    $iy = COPY %0
    $a = LD8go $iy, 0
    %0 = INC16r %0
    $a = LD8ap %0
    $iy = COPY %0
    $a = LD8go $iy, 0
    %0 = INC16r %0
    $a = LD8ap %0
    $iy = COPY %0
    $a = LD8go $iy, 0
    %0 = INC16r %0
    $a = LD8ap %0
    $iy = COPY %0
    $a = LD8go $iy, 0
    RET16 implicit-def $sps, implicit $sps, implicit $a
  bb.2:
    $a = LD8go %0, 2
    RET16 implicit-def $sps, implicit $sps, implicit $a
...
# CHECK-LABEL: name: indexed_arguments
# CHECK: %0:i16 = COPY $de
# CHECK: $a = LD8go %0, 2
