# RUN: llc -run-pass=z80-machine-prera-opt,z80-prepare-live-ranges -verify-machineinstrs %s -o - | FileCheck %s
# RUN: %python %S/Inputs/stable-lane-copies.py --llc llc --mir %s --work %t
#
# Constant lanes survive whole-pair constructions and copies. Carrying word
# updates and disagreeing definitions keep their actual page values.
--- |
  target triple = "z80"
  declare void @opaque()
  define void @copied_low() { ret void }
  define void @copied_high() { ret void }
  define void @carry_page() { ret void }
  define void @different_pages() { ret void }
...
---
name: copied_low
tracksRegLiveness: true
# CHECK-LABEL: name: copied_low
# CHECK: bb.1:
# CHECK: [[PAIR:%[0-9]+]].sub_low:r16 = COPY
# CHECK-NEXT: [[PAIR]].sub_high:r16 = LD8ri 49
# CHECK-NEXT: LD8pa [[PAIR]], $a
# CHECK-NEXT: [[PAIR]].sub_low:r16 = INC8r [[PAIR]].sub_low
# CHECK-NEXT: [[PAIR]].sub_high:r16 = LD8ri 49
# CHECK: LD8pa [[PAIR]], $a
# CHECK: CALL16 @opaque
# CHECK: [[NEXT:%[0-9]+]].sub_low:r16 = COPY
# CHECK-NEXT: [[NEXT]].sub_high:r16 = LD8ri 49
# CHECK-NEXT: LD8pa [[NEXT]], $a
# CHECK-NEXT: [[NEXT]].sub_low:r16 = INC8r [[NEXT]].sub_low
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $e
    %2:r16 = LD16ri 12544
    %2.sub_low:r16 = COPY $e
    %1:r16 = COPY %2
    %0:r16 = COPY %1
    JQ %bb.1
  bb.1:
    $a = LD8ri 17
    LD8pa %0, $a :: (volatile store (s8))
    %0.sub_low:r16 = INC8r %0.sub_low, implicit-def dead $f
    %0.sub_high:r16 = LD8ri 49
    $a = LD8ri 34
    LD8pa %0, $a :: (volatile store (s8))
    CALL16 @opaque, csr_z80_c, implicit $sps
    %0.sub_low:r16 = INC8r %0.sub_low, implicit-def dead $f
    $a = LD8ri 51
    LD8pa %0, $a :: (volatile store (s8))
    %0.sub_low:r16 = INC8r %0.sub_low, implicit-def dead $f
    $a = LD8ri 68
    LD8pa %0, $a :: (volatile store (s8))
    %0.sub_low:r16 = INC8r %0.sub_low, implicit-def dead $f
    $de = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $de
...
---
name: copied_high
tracksRegLiveness: true
# CHECK-LABEL: name: copied_high
# CHECK: bb.1:
# CHECK: [[PAIR:%[0-9]+]].sub_high:r16 = COPY
# CHECK-NEXT: [[PAIR]].sub_low:r16 = LD8ri 49
# CHECK-NEXT: LD8pa [[PAIR]], $a
# CHECK-NEXT: [[PAIR]].sub_high:r16 = DEC8r [[PAIR]].sub_high
# CHECK-NEXT: [[PAIR]].sub_low:r16 = LD8ri 49
# CHECK: LD8pa [[PAIR]], $a
# CHECK: CALL16 @opaque
# CHECK: [[NEXT:%[0-9]+]].sub_high:r16 = COPY
# CHECK-NEXT: [[NEXT]].sub_low:r16 = LD8ri 49
# CHECK-NEXT: LD8pa [[NEXT]], $a
# CHECK-NEXT: [[NEXT]].sub_high:r16 = DEC8r [[NEXT]].sub_high
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $e
    %2:r16 = LD16ri 49
    %2.sub_high:r16 = COPY $e
    %1:r16 = COPY %2
    %0:r16 = COPY %1
    JQ %bb.1
  bb.1:
    $a = LD8ri 17
    LD8pa %0, $a :: (volatile store (s8))
    %0.sub_high:r16 = DEC8r %0.sub_high, implicit-def dead $f
    %0.sub_low:r16 = LD8ri 49
    $a = LD8ri 34
    LD8pa %0, $a :: (volatile store (s8))
    CALL16 @opaque, csr_z80_c, implicit $sps
    %0.sub_high:r16 = DEC8r %0.sub_high, implicit-def dead $f
    $a = LD8ri 51
    LD8pa %0, $a :: (volatile store (s8))
    %0.sub_high:r16 = DEC8r %0.sub_high, implicit-def dead $f
    $a = LD8ri 68
    LD8pa %0, $a :: (volatile store (s8))
    %0.sub_high:r16 = DEC8r %0.sub_high, implicit-def dead $f
    $de = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $de
...
---
name: carry_page
tracksRegLiveness: true
# CHECK-LABEL: name: carry_page
# CHECK: bb.1:
# CHECK: LD8pa [[PAIR:%[0-9]+]], $a
# CHECK-NEXT: [[PAIR]]:r16 = INC16r [[PAIR]]
# CHECK-NEXT: LD8pa [[PAIR]], $a
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $e
    %1:r16 = LD16ri 12544
    %1.sub_low:r16 = COPY $e
    %2:r16 = LD16ri 16896
    %2.sub_low:r16 = COPY $e
    %0:r16 = COPY %1
    JQ %bb.1
  bb.1:
    $a = LD8ri 17
    LD8pa %0, $a :: (volatile store (s8))
    %0:r16 = INC16r %0
    LD8pa %0, $a :: (volatile store (s8))
    %0.sub_low:r16 = INC8r %0.sub_low, implicit-def dead $f
    LD8pa %0, $a :: (volatile store (s8))
    $de = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $de
...
---
name: different_pages
tracksRegLiveness: true
# CHECK-LABEL: name: different_pages
# CHECK: bb.1:
# CHECK: LD8pa
# CHECK: [[PAGE:%[0-9]+]].sub_high:r16 = LD8ri 66
# CHECK-NEXT: [[PAIR:%[0-9]+]]:r16 = COPY [[PAGE]]
# CHECK-NEXT: [[PAIR]].sub_low:r16 = INC8r [[PAIR]].sub_low
# CHECK-NEXT: LD8pa [[PAIR]], $a
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $e
    %1:r16 = LD16ri 12544
    %1.sub_low:r16 = COPY $e
    %2:r16 = LD16ri 16896
    %2.sub_low:r16 = COPY $e
    %0:r16 = COPY %1
    JQ %bb.1
  bb.1:
    $a = LD8ri 17
    LD8pa %0, $a :: (volatile store (s8))
    %0:r16 = COPY %2
    %0.sub_low:r16 = INC8r %0.sub_low, implicit-def dead $f
    LD8pa %0, $a :: (volatile store (s8))
    %0.sub_low:r16 = INC8r %0.sub_low, implicit-def dead $f
    LD8pa %0, $a :: (volatile store (s8))
    $de = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $de
...
