# RUN: llc -run-pass=z80-late-copy -verify-machineinstrs %s -o - | FileCheck %s
--- |
  target triple = "ez80"
  define void @wide() { ret void }
...
---
name: wide
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ubc, $ude, $uhl, $uiy, $ubc_alt, $ude_alt, $uhl_alt
    $iyl = LD8yy $e
    EXX24 implicit-def $uhl, implicit-def $ude, implicit-def $ubc, implicit-def $uhl_alt, implicit-def $ude_alt, implicit-def $ubc_alt, implicit $uhl, implicit $ude, implicit $ubc, implicit $uhl_alt, implicit $ude_alt, implicit $ubc_alt
    $ude = LD24ri 123456
    EXX24 implicit-def $uhl, implicit-def $ude, implicit-def $ubc, implicit-def $uhl_alt, implicit-def $ude_alt, implicit-def $ubc_alt, implicit $uhl, implicit $ude, implicit $ubc, implicit $uhl_alt, implicit $ude_alt, implicit $ubc_alt
    $iyl = LD8yy $e
    $ude = LD24ri 234567
    $iyl = LD8yy $e
    RET24 implicit-def $spl, implicit $spl, implicit $uiy
# CHECK-LABEL: name: wide
# CHECK: $iyl = LD8yy $e
# CHECK: EXX24
# CHECK: $ude = LD24ri 123456
# CHECK: EXX24
# CHECK-NOT: LD8yy
# CHECK: $ude = LD24ri 234567
# CHECK-NEXT: $iyl = LD8yy $e
...
