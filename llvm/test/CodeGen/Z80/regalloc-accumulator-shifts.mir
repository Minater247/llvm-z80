# RUN: llc -run-pass=z80-regalloc,virtregrewriter -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mattr=+alternate-regs -run-pass=z80-regalloc,virtregrewriter -verify-machineinstrs %s -o - | FileCheck %s
# Three cheap accumulator instructions repay the two boundary copies.
# Result flags must be dead for the shorter accumulator forms.
# CHECK-LABEL: name: shifts
# CHECK: $a = COPY $e
# CHECK: $a = SLA8g
# CHECK: $a = SLA8g
# CHECK: $a = SLA8g
# CHECK: $e = COPY killed $a
# CHECK-LABEL: name: rotates
# CHECK: $a = COPY $e
# CHECK: $a = RRC8g
# CHECK: $a = RRC8g
# CHECK: $a = RRC8g
# CHECK: $e = COPY killed $a
# CHECK-LABEL: name: live_flags
# CHECK: $e = SLA8g
# CHECK: KILL $f
# CHECK: $e = SLA8g
# CHECK: KILL $f
# CHECK: $e = SLA8g
# CHECK: KILL $f
# CHECK-LABEL: name: single_shift
# CHECK: $e = SLA8g
--- |
  target triple = "z80"
  define void @shifts() { ret void }
  define void @rotates() minsize { ret void }
  define void @live_flags() { ret void }
  define void @single_shift() { ret void }
...
---
name: shifts
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $e
    %0:g8 = COPY $e
    %0 = SLA8g %0, implicit-def dead $f
    %0 = SLA8g %0, implicit-def dead $f
    %0 = SLA8g %0, implicit-def dead $f
    $e = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $e
...
---
name: rotates
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $e
    %0:g8 = COPY $e
    %0 = RRC8g %0, implicit-def dead $f
    %0 = RRC8g %0, implicit-def dead $f
    %0 = RRC8g %0, implicit-def dead $f
    $e = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $e
...
---
name: live_flags
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $e
    %0:g8 = COPY $e
    %0 = SLA8g %0, implicit-def $f
    KILL $f
    %0 = SLA8g %0, implicit-def $f
    KILL $f
    %0 = SLA8g %0, implicit-def $f
    KILL $f
    $e = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $e
...
---
name: single_shift
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $e
    %0:g8 = COPY $e
    %0 = SLA8g %0, implicit-def dead $f
    $e = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $e
...
