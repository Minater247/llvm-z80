# RUN: llc -mattr=+alternate-regs -run-pass=z80-bank-regions -verify-machineinstrs %s -o - | FileCheck %s
--- |
  target triple = "z80"
  define void @transfer_cfi() uwtable "static_stack_needs_ix" { ret void }
  define void @block_boundary() nounwind { ret void }
  define void @undefined_input() nounwind { ret void }
...
---
name: transfer_cfi
tracksRegLiveness: true
# CHECK-LABEL: name: transfer_cfi
# CHECK: PUSH16r $iy
# CHECK-NEXT: CFI_INSTRUCTION adjust_cfa_offset 2
# CHECK-NEXT: EXX16
# CHECK-NEXT: $hl = POP16r
# CHECK-NEXT: CFI_INSTRUCTION adjust_cfa_offset -2
# CHECK-NEXT: $hl = INC16r $hl
# CHECK-NEXT: PUSH16r $hl
# CHECK-NEXT: CFI_INSTRUCTION adjust_cfa_offset 2
# CHECK-NEXT: EXX16
# CHECK-NEXT: $de = POP16r
# CHECK-NEXT: CFI_INSTRUCTION adjust_cfa_offset -2
# CHECK-NEXT: RET16
body: |
  bb.0:
    liveins: $iy
    $hl_alt = ALT_SAVE16 $iy
    $hl_alt = BANK_INC16 $hl_alt
    $de = ALT_LOAD16 $hl_alt
    RET16 implicit-def $sps, implicit $sps, implicit $de
...
---
name: block_boundary
tracksRegLiveness: true
# CHECK-LABEL: name: block_boundary
# CHECK: $hl_alt = ALT_SAVE16 $iy
# CHECK-NEXT: JP16 %bb.1
# CHECK: bb.1:
# CHECK: EXX16
# CHECK-NEXT: $hl = INC16r $hl
# CHECK-NEXT: PUSH16r $hl
# CHECK-NEXT: EXX16
# CHECK-NEXT: $de = POP16r
body: |
  bb.0:
    liveins: $iy
    $hl_alt = ALT_SAVE16 $iy
    JP16 %bb.1
  bb.1:
    liveins: $hl_alt
    $hl_alt = BANK_INC16 $hl_alt
    $de = ALT_LOAD16 $hl_alt
    RET16 implicit-def $sps, implicit $sps, implicit $de
...
---
name: undefined_input
tracksRegLiveness: true
# CHECK-LABEL: name: undefined_input
# CHECK: PUSH16r undef $iy
# CHECK-NEXT: EXX16
# CHECK-NEXT: $hl = POP16r
# CHECK-NEXT: $hl = INC16r $hl
# CHECK-NEXT: PUSH16r $hl
# CHECK-NEXT: EXX16
# CHECK-NEXT: $de = POP16r
body: |
  bb.0:
    $hl_alt = ALT_SAVE16 undef $iy
    $hl_alt = BANK_INC16 $hl_alt
    $de = ALT_LOAD16 $hl_alt
    RET16 implicit-def $sps, implicit $sps, implicit $de
...
