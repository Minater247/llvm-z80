# RUN: llc -run-pass=z80-regalloc,virtregrewriter -verify-machineinstrs %s -o - | FileCheck %s
#
# IX stays live while two block addresses compete for IY. Defer splitting the
# blocked address until other original ranges have an allocation attempt.
# Both address complements then stay in primary pairs during the byte copies;
# eagerly splitting instead reloads the source address from a spill per byte.
#
# CHECK-LABEL: name: copy_indexed_blocks
# CHECK: $a = LD8gp
# CHECK-NOT: LD88ro
# CHECK-NOT: LD88or
# CHECK: LD8og {{.*}}, 8, {{.*}}$a
# CHECK: Sub16ao
--- |
  target triple = "z80"
  define void @copy_indexed_blocks() { ret void }
...
---
name: copy_indexed_blocks
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ix
    %0:o16 = LD16ri 0
    %1:r16 = LD16ri 16384
    %2:r16 = LD16ri 32775
    %3:o16 = LD16ri 16
    %4:o16 = LD16ri 1809
    %5:r16 = COPY %0
    JQ %bb.1
  bb.1:
    %5:r16 = ADD16rr %5, %3, implicit-def dead $f
    %6:i16 = COPY %1
    %6:i16 = ADD16rr %6, %0, implicit-def dead $f
    %7:i16 = COPY %2
    %7:i16 = ADD16rr %7, %0, implicit-def dead $f
    %8:g8 = LD8gp %6 :: (load (s8))
    LD8og %7, -7, %8 :: (volatile store (s8))
    %9:g8 = LD8go %6, 1 :: (load (s8))
    LD8og %7, -6, %9 :: (volatile store (s8))
    %10:g8 = LD8go %6, 2 :: (load (s8))
    LD8og %7, -5, %10 :: (volatile store (s8))
    %11:g8 = LD8go %6, 3 :: (load (s8))
    LD8og %7, -4, %11 :: (volatile store (s8))
    %12:g8 = LD8go %6, 4 :: (load (s8))
    LD8og %7, -3, %12 :: (volatile store (s8))
    %13:g8 = LD8go %6, 5 :: (load (s8))
    LD8og %7, -2, %13 :: (volatile store (s8))
    %14:g8 = LD8go %6, 6 :: (load (s8))
    LD8og %7, -1, %14 :: (volatile store (s8))
    %15:g8 = LD8go %6, 7 :: (load (s8))
    LD8pg %7, %15 :: (volatile store (s8))
    %16:g8 = LD8go %6, 8 :: (load (s8))
    LD8og %7, 1, %16 :: (volatile store (s8))
    %17:g8 = LD8go %6, 9 :: (load (s8))
    LD8og %7, 2, %17 :: (volatile store (s8))
    %18:g8 = LD8go %6, 10 :: (load (s8))
    LD8og %7, 3, %18 :: (volatile store (s8))
    %19:g8 = LD8go %6, 11 :: (load (s8))
    LD8og %7, 4, %19 :: (volatile store (s8))
    %20:g8 = LD8go %6, 12 :: (load (s8))
    LD8og %7, 5, %20 :: (volatile store (s8))
    %21:g8 = LD8go %6, 13 :: (load (s8))
    LD8og %7, 6, %21 :: (volatile store (s8))
    %22:g8 = LD8go %6, 14 :: (load (s8))
    LD8og %7, 7, %22 :: (volatile store (s8))
    %23:g8 = LD8go %6, 15 :: (load (s8))
    LD8og %7, 8, %23 :: (volatile store (s8))
    $hl = COPY %0
    Sub16ao %4, implicit-def dead $hl, implicit-def $f, implicit killed $hl
    %0:o16 = COPY %5
    JQCC %bb.1, 3, implicit killed $f
    JQ %bb.2
  bb.2:
    KILL $ix
    RET16 implicit-def $sps, implicit $sps
...
