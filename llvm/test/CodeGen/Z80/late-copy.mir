# RUN: llc -run-pass=z80-late-copy -verify-machineinstrs %s -o - | FileCheck %s
# RUN: %python %S/Inputs/late-copy.py --llc llc --work %t
--- |
  target triple = "z80"
  declare void @opaque()
  define void @reuse() { ret void }
  define void @clobbers() { ret void }
  define void @boundaries() { ret void }
  define void @reuse_address() { ret void }
  define void @partial_address() { ret void }
...
---
name: reuse
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $bc, $de, $hl, $iy, $bc_alt, $de_alt, $hl_alt
    $iyl = LD8yy $e
    $iyh = LD8yy $d, implicit-def $iy
    $a = LD8ap killed $iy
    EXX16 implicit-def $hl, implicit-def $de, implicit-def $bc, implicit-def $hl_alt, implicit-def $de_alt, implicit-def $bc_alt, implicit $hl, implicit $de, implicit $bc, implicit $hl_alt, implicit $de_alt, implicit $bc_alt
    $e = LD8ri 17
    EXX16 implicit-def $hl, implicit-def $de, implicit-def $bc, implicit-def $hl_alt, implicit-def $de_alt, implicit-def $bc_alt, implicit $hl, implicit $de, implicit $bc, implicit $hl_alt, implicit $de_alt, implicit $bc_alt
    $iyl = LD8yy $e
    $iyh = LD8yy $d, implicit-def $iy
    RET16 implicit-def $sps, implicit $sps, implicit $iy
# CHECK-LABEL: name: reuse
# CHECK: $iyl = LD8yy $e
# CHECK-NEXT: $iyh = LD8yy $d, implicit-def $iy
# CHECK-NEXT: $a = LD8ap $de
# CHECK: EXX16
# CHECK: EXX16
# CHECK-NOT: LD8yy
# CHECK: RET16
...
---
name: clobbers
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $bc, $de, $hl, $bc_alt, $de_alt, $hl_alt
    $iyl = LD8yy $e
    $de = LD16ri 1234
    $iyl = LD8yy $e
    $iy = LD16ri 5678
    $iyl = LD8yy $e
    EXX16 implicit-def $hl, implicit-def $de, implicit-def $bc, implicit-def $hl_alt, implicit-def $de_alt, implicit-def $bc_alt, implicit $hl, implicit $de, implicit $bc, implicit $hl_alt, implicit $de_alt, implicit $bc_alt
    $iyl = LD8yy $e
    RET16 implicit-def $sps, implicit $sps, implicit $iy
# CHECK-LABEL: name: clobbers
# CHECK: $iyl = LD8yy $e
# CHECK: $de = LD16ri 1234
# CHECK-NEXT: $iyl = LD8yy $e
# CHECK-NEXT: $iy = LD16ri 5678
# CHECK-NEXT: $iyl = LD8yy $e
# CHECK: EXX16
# CHECK-NEXT: $iyl = LD8yy $e
...
---
name: boundaries
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $bc, $de, $hl, $bc_alt, $de_alt, $hl_alt
    $iyl = LD8yy $e
    CALL16 @opaque, csr_z80_c, implicit-def $de, implicit-def $sps, implicit $sps
    $iyl = LD8yy $e
    JP16 %bb.1
  bb.1:
    liveins: $bc, $de, $hl, $bc_alt, $de_alt, $hl_alt
    $iyl = LD8yy $e
    RET16 implicit-def $sps, implicit $sps, implicit $iyl
# CHECK-LABEL: name: boundaries
# CHECK: $iyl = LD8yy $e
# CHECK: CALL16
# CHECK-NEXT: $iyl = LD8yy $e
# CHECK: bb.1:
# CHECK: $iyl = LD8yy $e
...
---
name: reuse_address
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $bc, $de, $a
    $iyl = LD8yy $c
    $iyh = LD8yy $b, implicit-def $iy
    LD8og $iy, 0, $a :: (volatile store (s8))
    $iyl = LD8yy $e
    $iyh = LD8yy $d, implicit-def $iy
    $l = LD8go $iy, 3
    $iyl = LD8yy $c
    $iyh = LD8yy $b, implicit-def $iy
    LD8pg $iy, $a
    $iyl = LD8yy $e
    $iyh = LD8yy $d, implicit-def $iy
    $l = LD8go $iy, 4
    RET16 implicit-def $sps, implicit $sps, implicit $iy, implicit $l
# CHECK-LABEL: name: reuse_address
# CHECK-NOT: LD8yy $c
# CHECK: LD8pa $bc, $a :: (volatile store (s8))
# CHECK-NEXT: $iyl = LD8yy $e
# CHECK-NEXT: $iyh = LD8yy $d, implicit-def $iy
# CHECK-NEXT: $l = LD8go $iy, 3
# CHECK-NEXT: LD8pa $bc, $a
# CHECK-NEXT: $l = LD8go $iy, 4
...
---
name: partial_address
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $de
    $iyl = LD8yy $e
    $iyh = LD8yy $d, implicit-def $iy
    $e = INC8r $e, implicit-def $f
    $a = LD8ap $iy
    RET16 implicit-def $sps, implicit $sps, implicit $a
# CHECK-LABEL: name: partial_address
# CHECK: $e = INC8r $e
# CHECK-NEXT: $a = LD8ap $iy
...
