# RUN: llc -run-pass=z80-machine-prera-opt -verify-machineinstrs %s -o - | FileCheck %s
--- |
  target triple = "z80"
  declare void @external()
  define i8 @late_constant() { ret i8 0 }
  define i8 @argument() { ret i8 0 }
  define i8 @redefined() { ret i8 0 }
  define i16 @partial() { ret i16 0 }
...
---
name: late_constant
tracksRegLiveness: true
# CHECK-LABEL: name: late_constant
# CHECK: CALL16
# CHECK-NEXT: %0:r8 = LD8ri 2
# CHECK-NEXT: $a = COPY %0
body: |
  bb.0:
    %0:r8 = LD8ri 2
    CALL16 @external, csr_z80_c, implicit-def $sps, implicit $sps
    $a = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $a
...
---
name: argument
tracksRegLiveness: true
# A value consumed by call setup remains before that use.
# CHECK-LABEL: name: argument
# CHECK: %0:r8 = LD8ri 2
# CHECK-NEXT: $l = COPY %0
# CHECK-NEXT: CALL16
body: |
  bb.0:
    %0:r8 = LD8ri 2
    $l = COPY %0
    CALL16 @external, csr_z80_c, implicit-def $sps, implicit $sps, implicit $l
    $a = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $a
...
---
name: redefined
tracksRegLiveness: true
# Each reaching constant moves past only the calls preceding its own use.
# CHECK-LABEL: name: redefined
# CHECK: CALL16
# CHECK-NEXT: %0:r8 = LD8ri 2
# CHECK-NEXT: $l = COPY %0
# CHECK-NEXT: CALL16
# CHECK-NEXT: CALL16
# CHECK-NEXT: %0:r8 = LD8ri 3
# CHECK-NEXT: $a = COPY %0
body: |
  bb.0:
    %0:r8 = LD8ri 2
    CALL16 @external, csr_z80_c, implicit-def $sps, implicit $sps
    $l = COPY %0
    CALL16 @external, csr_z80_c, implicit-def $sps, implicit $sps, implicit $l
    %0:r8 = LD8ri 3
    CALL16 @external, csr_z80_c, implicit-def $sps, implicit $sps
    $a = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $a
...
---
name: partial
tracksRegLiveness: true
# A partial definition also depends on the previously defined byte.
# CHECK-LABEL: name: partial
# CHECK: undef %0.sub_high:r16 = LD8ri 3
# CHECK-NEXT: %0.sub_low:r16 = LD8ri 2
# CHECK-NEXT: CALL16
body: |
  bb.0:
    undef %0.sub_high:r16 = LD8ri 3
    %0.sub_low:r16 = LD8ri 2
    CALL16 @external, csr_z80_c, implicit-def $sps, implicit $sps
    $hl = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $hl
...
