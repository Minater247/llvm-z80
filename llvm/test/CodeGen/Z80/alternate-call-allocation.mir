# RUN: llc -mattr=+alternate-regs -run-pass=z80-alternate-regalloc -verify-machineinstrs %s -o - | FileCheck %s
# CHECK-LABEL: name: preserved
# CHECK: $de_alt = ALT_SAVE16 $hl
# CHECK: CALL16
# CHECK: $de = ALT_LOAD16 $de_alt
# CHECK-LABEL: name: intersection
# CHECK-NOT: ALT_
# CHECK: LD88or %stack.0
# CHECK: CALL16
# CHECK: CALL16
# CHECK: LD88ro %stack.0
# CHECK-LABEL: name: unknown
# CHECK-NOT: ALT_
# CHECK: LD88or %stack.0
# CHECK: CALL16
# CHECK: LD88ro %stack.0
# CHECK-LABEL: name: explicit_clobber
# CHECK-NOT: ALT_
# CHECK: LD88or %stack.0
# CHECK: CALL16
# CHECK: LD88ro %stack.0
# CHECK-LABEL: name: loop_preserved
# CHECK: $de_alt = ALT_SAVE16 $hl
# CHECK: bb.1:
# CHECK: $de = ALT_LOAD16 $de_alt
# CHECK: CALL16
# CHECK: JP16 %bb.1
--- |
  target triple = "z80"
  declare void @callee()
  define void @preserved() { ret void }
  define void @intersection() { ret void }
  define void @unknown() { ret void }
  define void @explicit_clobber() { ret void }
  define void @loop_preserved() { ret void }
...
---
name: preserved
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $hl
    LD88or %stack.0, 0, $hl
    CALL16 @callee, CustomRegMask($de_alt, $d_alt, $e_alt), implicit-def $sps, implicit $sps
    $de = LD88ro %stack.0, 0
    KILL $de
    RET16 implicit-def $sps, implicit $sps
...
---
name: intersection
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $hl
    LD88or %stack.0, 0, $hl
    CALL16 @callee, CustomRegMask($de_alt, $d_alt, $e_alt), implicit-def $sps, implicit $sps
    CALL16 @callee, CustomRegMask($bc_alt, $b_alt, $c_alt), implicit-def $sps, implicit $sps
    $de = LD88ro %stack.0, 0
    KILL $de
    RET16 implicit-def $sps, implicit $sps
...
---
name: unknown
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $hl
    LD88or %stack.0, 0, $hl
    CALL16 @callee, implicit-def $sps, implicit $sps
    $de = LD88ro %stack.0, 0
    KILL $de
    RET16 implicit-def $sps, implicit $sps
...
---
name: explicit_clobber
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $hl
    LD88or %stack.0, 0, $hl
    CALL16 @callee, CustomRegMask($de_alt, $d_alt, $e_alt), implicit-def $de_alt, implicit-def $sps, implicit $sps
    $de = LD88ro %stack.0, 0
    KILL $de
    RET16 implicit-def $sps, implicit $sps
...
---
name: loop_preserved
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $hl
    LD88or %stack.0, 0, $hl
    JP16 %bb.1
  bb.1:
    $de = LD88ro %stack.0, 0
    KILL $de
    CALL16 @callee, CustomRegMask($de_alt, $d_alt, $e_alt), implicit-def $sps, implicit $sps
    JP16 %bb.1
...
