# RUN: llc -run-pass=z80-machine-prera-opt -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -run-pass=z80-machine-prera-opt,z80-prepare-live-ranges,z80-regalloc,virtregrewriter -verify-machineinstrs %s -o /dev/null
# RUN: llc -run-pass=z80-machine-prera-opt,z80-prepare-live-ranges,greedy,virtregrewriter -verify-machineinstrs %s -o /dev/null
# RUN: llc -start-before=z80-machine-prera-opt -verify-machineinstrs %s -o %t.s
# RUN: %python %S/Inputs/cursor-values.py %t.s cursor_tail
# RUN: llc -start-before=z80-machine-prera-opt -regalloc=greedy -verify-machineinstrs %s -o %t.greedy.s
# RUN: %python %S/Inputs/cursor-values.py %t.greedy.s cursor_tail
--- |
  target triple = "z80"
  declare i16 @external(i16)
  define i8 @cursor_tail() { ret i8 0 }
  define i8 @live_out_pair() { ret i8 0 }
...
---
name: cursor_tail
tracksRegLiveness: true
# A whole-pair update after the loop must not keep the loop's invariant high
# byte tied to its changing low byte. The terminal pair dies within bb.2.
# CHECK-LABEL: name: cursor_tail
# CHECK: bb.0:
# CHECK: %[[HI:[0-9]+]]:r8 = COPY $d
# CHECK-NEXT: %[[LO:[0-9]+]]:r8 = COPY $e
# CHECK: bb.1:
# CHECK: undef %[[ARG:[0-9]+]].sub_low:r16 = COPY %[[LO]]
# CHECK-NEXT: %[[ARG]].sub_high:r16 = COPY %[[HI]]
# CHECK-NEXT: $de = COPY %[[ARG]]
# CHECK: %[[LO]]:r8 = COPY $l
# CHECK: bb.2:
# CHECK: undef %[[IN:[0-9]+]].sub_low:r16 = COPY %[[LO]]
# CHECK-NEXT: %[[IN]].sub_high:r16 = COPY %[[HI]]
# CHECK-NEXT: %[[PAIR:[0-9]+]]:r16 = COPY %[[IN]]
# CHECK-NEXT: $a = LD8ap %[[PAIR]]
# CHECK-NEXT: %[[PAIR]]:r16 = INC16r %[[PAIR]]
# CHECK-NEXT: $a = LD8ap %[[PAIR]]
body: |
  bb.0:
    successors: %bb.1
    liveins: $de
    undef %0.sub_high:r16 = COPY $d
    %0.sub_low:r16 = COPY $e
    JQ %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    $de = COPY %0
    CALL16 @external, csr_z80_c, implicit-def $sps, implicit $sps, implicit $de, implicit-def $hl
    %0.sub_low:r16 = COPY $l
    $a = COPY $l
    OR8ar $a, implicit $a, implicit-def $a, implicit-def $f
    JQCC %bb.1, 0, implicit $f
    JQ %bb.2
  bb.2:
    $a = LD8ap %0
    %0:r16 = INC16r %0
    $a = LD8ap %0
    RET16 implicit-def $sps, implicit $sps, implicit $a
...
---
name: live_out_pair
tracksRegLiveness: true
# A word updated in bb.2 remains the source of the successor's load.
# CHECK-LABEL: name: live_out_pair
# CHECK: bb.2:
# CHECK-NEXT: successors: %bb.3
# CHECK: %0:r16 = INC16r %0
# CHECK-NEXT: JQ %bb.3
# CHECK: bb.3:
# CHECK: $a = LD8ap %0
body: |
  bb.0:
    successors: %bb.1
    liveins: $de
    undef %0.sub_high:r16 = COPY $d
    %0.sub_low:r16 = COPY $e
    JQ %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    $de = COPY %0
    CALL16 @external, csr_z80_c, implicit-def $sps, implicit $sps, implicit $de, implicit-def $hl
    %0.sub_low:r16 = COPY $l
    $a = COPY $l
    OR8ar $a, implicit $a, implicit-def $a, implicit-def $f
    JQCC %bb.1, 0, implicit $f
    JQ %bb.2
  bb.2:
    successors: %bb.3
    %0:r16 = INC16r %0
    JQ %bb.3
  bb.3:
    $a = LD8ap %0
    RET16 implicit-def $sps, implicit $sps, implicit $a
...
