# RUN: llc -run-pass=z80-post-rewrite -verify-machineinstrs %s -o - | FileCheck %s
--- |
  target triple = "z80"
  define void @dead_bc() { ret void }
  define void @live_c() { ret void }
  define void @live_b_out() { ret void }
...
---
name: dead_bc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $de, $hl
    $iy = COPY $de
    $de = LD16ri 19
    $iy = ADD16ao killed $iy, killed $de, implicit-def dead $f
    $de = COPY killed $iy
    RET16 implicit-def $sps, implicit $sps, implicit $de, implicit $hl
# CHECK-LABEL: name: dead_bc
# CHECK: EX16DE
# CHECK-NEXT: $bc = LD16ri 19
# CHECK-NEXT: $hl = ADD16ao $hl, killed $bc
# CHECK-NEXT: EX16DE
# CHECK-NOT: COPY
...
---
name: live_c
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $de, $hl, $c
    $iy = COPY $de
    $de = LD16ri 19
    $iy = ADD16ao killed $iy, killed $de, implicit-def dead $f
    $de = COPY killed $iy
    RET16 implicit-def $sps, implicit $sps, implicit $de, implicit $hl, implicit $c
# CHECK-LABEL: name: live_c
# CHECK: $iy = COPY $de
# CHECK-NEXT: $de = LD16ri 19
# CHECK-NEXT: $iy = ADD16ao
# CHECK-NEXT: $de = COPY killed $iy
...
---
name: live_b_out
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $de, $hl, $b
    $iy = COPY $de
    $de = LD16ri 19
    $iy = ADD16ao killed $iy, killed $de, implicit-def dead $f
    $de = COPY killed $iy
    JP16 %bb.1
  bb.1:
    liveins: $b, $de, $hl
    RET16 implicit-def $sps, implicit $sps, implicit $de, implicit $hl, implicit $b
# CHECK-LABEL: name: live_b_out
# CHECK: $iy = COPY $de
# CHECK-NEXT: $de = LD16ri 19
# CHECK-NEXT: $iy = ADD16ao
# CHECK-NEXT: $de = COPY killed $iy
...
