# RUN: llc -start-before=z80-regalloc -stop-after=virtregrewriter -regalloc=z80 -mattr=+alternate-regs -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -start-before=z80-regalloc -regalloc=z80 -mattr=+alternate-regs -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=FINAL
#
# Bank-capable stack accesses lower to ordinary spills when assigned primary
# registers. An index pair requires scratch preservation, which costs more
# than a primary pair plus a register transfer in these short ranges.
--- |
  target triple = "z80"
  declare void @opaque()
  define void @index_reload() { ret void }
  define void @index_store() optsize { ret void }
  define void @folded_reload() optsize { ret void }
...
---
name: index_reload
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
# CHECK-LABEL: name: index_reload
# CHECK: $de = BANK_LD16ro %stack.0, 0
# CHECK-NEXT: $iy = COPY killed $de
body: |
  bb.0:
    %0:b16 = BANK_LD16ro %stack.0, 0
    $iy = COPY %0
    RET16 implicit-def $sps, implicit $sps, implicit $iy
...
---
name: index_store
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
# CHECK-LABEL: name: index_store
# CHECK: $hl = COPY $iy
# CHECK-NEXT: BANK_LD16or %stack.0, 0, killed $hl
body: |
  bb.0:
    liveins: $iy
    %0:b16 = COPY $iy
    BANK_LD16or %stack.0, 0, %0
    RET16 implicit-def $sps, implicit $sps
...
# The consumer is allocated while its input is still a register copy. Spilling
# that input later folds the copy into a reload, changing its placement cost.
# CHECK-LABEL: name: folded_reload
# CHECK: CALL16 @opaque
# CHECK: $hl = BANK_LD16ro
# CHECK-NEXT: $hl = INC16r killed $hl
# FINAL-LABEL: folded_reload:
# FINAL: call opaque
# FINAL-NEXT: ld l, (ix - 2)
# FINAL-NEXT: ld h, (ix - 1)
# FINAL-NEXT: inc hl
# FINAL-NEXT: push hl
# FINAL-NEXT: pop iy
# FINAL-NEXT: ld a, (iy + 3)
---
name: folded_reload
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $de
    %0:b16 = COPY $de
    CALL16 @opaque, csr_z80_c, implicit $sps
    %1:r16 = COPY %0
    %1:r16 = INC16r %1
    %2:i16 = COPY %1
    $a = LD8ro %2, 3 :: (load (s8))
    RET16 implicit-def $sps, implicit $sps, implicit $a
...
